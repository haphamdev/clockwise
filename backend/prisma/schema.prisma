generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserStatus {
  pending
  active
  deactivated
}

enum TeamMemberRole {
  manager
  member
}

enum ProjectStatus {
  active
  archived
}

enum InvitationStatus {
  pending
  accepted
  revoked
  failed
}

enum TimeLogStatus {
  active
  archived
}

enum ImportJobStatus {
  pending
  processing
  completed
  failed
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  teams       Team[]
  projects    Project[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@map("organization")
}

model User {
  id          String     @id @default(uuid())
  orgId       String     @map("org_id")
  email       String     @unique @db.VarChar(255)
  name        String     @db.VarChar(255)
  avatarUrl   String?    @map("avatar_url") @db.VarChar(512)
  isAdmin     Boolean    @default(false) @map("is_admin")
  status      UserStatus @default(pending)
  lastLoginAt  DateTime? @map("last_login_at")
  refreshToken  String?   @map("refresh_token")
  preferences   Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  org              Organization   @relation(fields: [orgId], references: [id])
  teamMemberships  TeamMember[]
  timeLogs         TimeLog[]
  createdTasks     Task[]
  sentInvitations  Invitation[]   @relation("InvitedBy")

  @@map("user")
}

model Team {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org                   Organization               @relation(fields: [orgId], references: [id])
  members               TeamMember[]
  invitationAssignments InvitationTeamAssignment[]
  projectTeams          ProjectTeam[]

  @@unique([orgId, name])
  @@map("team")
}

model TeamMember {
  id        String         @id @default(uuid())
  teamId    String         @map("team_id")
  userId    String         @map("user_id")
  role      TeamMemberRole
  createdAt DateTime       @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_member")
}

model Project {
  id          String        @id @default(uuid())
  orgId       String        @map("org_id")
  name        String        @db.VarChar(255)
  description String?       @db.Text
  status      ProjectStatus @default(active)
  settings    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  org          Organization  @relation(fields: [orgId], references: [id])
  projectTeams ProjectTeam[]
  tasks        Task[]
  timeLogs     TimeLog[]

  @@map("project")
}

model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  teamId    String   @map("team_id")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])
  team    Team    @relation(fields: [teamId], references: [id])

  @@unique([projectId, teamId])
  @@map("project_team")
}

model Task {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  label           String   @db.VarChar(100)
  labelNormalized String   @map("label_normalized") @db.VarChar(100)
  description     String?  @db.Text
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project      Project       @relation(fields: [projectId], references: [id])
  creator      User          @relation(fields: [createdBy], references: [id])
  timeLogTasks TimeLogTask[]

  @@unique([projectId, labelNormalized])
  @@map("task")
}

model TimeLog {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  projectId String        @map("project_id")
  date      DateTime      @db.Date
  hours     Decimal       @db.Decimal(5, 2)
  notes     String?       @db.Text
  status    TimeLogStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id])
  timeLogTasks TimeLogTask[]

  @@index([userId, date, status])
  @@index([projectId, date, status])
  @@map("time_log")
}

model TimeLogTask {
  id        String   @id @default(uuid())
  timeLogId String   @map("time_log_id")
  taskId    String   @map("task_id")
  createdAt DateTime @default(now()) @map("created_at")

  timeLog TimeLog @relation(fields: [timeLogId], references: [id])
  task    Task    @relation(fields: [taskId], references: [id])

  @@unique([timeLogId, taskId])
  @@map("time_log_task")
}

model Invitation {
  id        String           @id @default(uuid())
  orgId     String           @map("org_id")
  email     String           @db.VarChar(255)
  invitedBy String           @map("invited_by")
  token     String           @unique @db.VarChar(255)
  expiresAt DateTime         @map("expires_at")
  status    InvitationStatus @default(pending)
  createdAt DateTime         @default(now()) @map("created_at")

  org             Organization              @relation(fields: [orgId], references: [id])
  sender          User                      @relation("InvitedBy", fields: [invitedBy], references: [id])
  teamAssignments InvitationTeamAssignment[]

  @@map("invitation")
}

model InvitationTeamAssignment {
  id           String         @id @default(uuid())
  invitationId String         @map("invitation_id")
  teamId       String         @map("team_id")
  role         TeamMemberRole

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id])

  @@unique([invitationId, teamId])
  @@map("invitation_team_assignment")
}

model ImportJob {
  id          String          @id @default(uuid())
  orgId       String          @map("org_id")
  userId      String          @map("user_id")
  type        String          @db.VarChar(50)
  status      ImportJobStatus @default(pending)
  totalRows   Int             @default(0) @map("total_rows")
  imported    Int             @default(0)
  errorCount  Int             @default(0) @map("error_count")
  bullJobId   String?         @map("bull_job_id") @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at")
  completedAt DateTime?       @map("completed_at")

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@map("import_job")
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id")
  action      String   @db.VarChar(50)
  performedBy String   @map("performed_by")
  metadata    Json     @default("{}")
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([entityType, entityId])
  @@index([orgId, createdAt])
  @@index([performedBy])
  @@map("audit_log")
}
