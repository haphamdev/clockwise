# ─── Database ────────────────────────────────────────────────────────────────
# Use "db" as host when running in Docker, "localhost" when running natively
DATABASE_URL="postgresql://clockwise:clockwise@db:5432/clockwise"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-256-bit-secret"
JWT_REFRESH_SECRET="replace-with-another-random-256-bit-secret"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# In dev: http://localhost:3000/api/v1/auth/google/callback
# In prod: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# ─── Admin Setup ─────────────────────────────────────────────────────────────
# Email for the initial admin user (created on first seed)
ADMIN_EMAIL="you@example.com"

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
# NODE_ENV is set by docker-compose files — do not set here

# ─── Redis ──────────────────────────────────────────────────────────────────
# Use "redis" as host when running in Docker, "localhost" when running natively
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD="clockwise-redis-dev"

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# Leave SMTP_HOST unset to log emails to console instead of sending.
# Gmail dev:   SMTP_HOST=smtp.gmail.com  (use App Password, not your real password)
# Resend prod: SMTP_HOST=smtp.resend.com SMTP_USER=resend SMTP_PASS=re_xxxxx
# SMTP_HOST=""
# SMTP_PORT=465
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM=""               # Defaults to SMTP_USER if unset

# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_DIR="./logs"          # Directory for log files (default: ./logs)
# LOG_LEVEL="info"          # Min level: error | warn | info | debug | verbose
# LOG_MAX_SIZE="20m"        # Max file size before rotation
# LOG_MAX_FILES="14d"       # How long to keep rotated files

# ─── Database (postgres service) ─────────────────────────────────────────────
POSTGRES_USER="clockwise"
POSTGRES_PASSWORD="clockwise"
POSTGRES_DB="clockwise"
